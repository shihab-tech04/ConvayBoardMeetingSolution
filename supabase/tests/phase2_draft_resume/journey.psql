-- Synthetic disposable PG17 only. Not real Auth, native backup or production UAT.
\set ON_ERROR_STOP on
\ir ../wsf_ten_foundation/bootstrap.sql
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
  SELECT nullif(current_setting('request.jwt.claim.sub',true),'')::uuid
$$;
CREATE TABLE public.user_profiles(user_id uuid PRIMARY KEY REFERENCES auth.users(id),
 account_role text NOT NULL, account_status text NOT NULL);
\ir ../../migrations/20261123102123_convay_ten_private_foundation_staging.sql
\ir ../../migrations/20261123174000_convay_tenant_control_plane_provisioning.sql
\ir ../../migrations/20261123210000_convay_meeting_template_versioning.sql
\ir ../../migrations/20261124112000_convay_tenant_owned_meeting_draft_snapshot.sql
\ir ../../migrations/20261124124000_convay_company_draft_revision_recovery.sql
\ir candidate.sql

BEGIN;
INSERT INTO auth.users(id) VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'),
 ('cccccccc-cccc-4ccc-8ccc-cccccccccccc');
INSERT INTO public.user_profiles VALUES
 ('aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','user','active'),
 ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','user','active'),
 ('cccccccc-cccc-4ccc-8ccc-cccccccccccc','user','active');
INSERT INTO convay_private.tenants(id,display_name,lifecycle_state) VALUES
 ('11111111-1111-4111-8111-111111111111','Synthetic company A','active'),
 ('22222222-2222-4222-8222-222222222222','Synthetic company B','active');
INSERT INTO convay_private.tenant_memberships(tenant_id,user_id,membership_role) VALUES
 ('11111111-1111-4111-8111-111111111111','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','tenant_admin'),
 ('22222222-2222-4222-8222-222222222222','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','tenant_admin'),
 ('11111111-1111-4111-8111-111111111111','cccccccc-cccc-4ccc-8ccc-cccccccccccc','member');

SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',true);
DO $test$
DECLARE
 a uuid:='11111111-1111-4111-8111-111111111111';
 b uuid:='22222222-2222-4222-8222-222222222222';
 d jsonb:='{"steps":[{"id":"details","title":"Meeting Details","fields":[{"id":"purpose","label":"Purpose","type":"text","required":true}]},{"id":"participants","title":"Participants","fields":[{"id":"roster","label":"Roster","type":"participants","required":true}]},{"id":"materials","title":"Agendas and Documents","fields":[{"id":"agenda","label":"Agenda","type":"agenda","required":false}]},{"id":"mode_quorum","title":"Meeting Mode and Quorum","fields":[{"id":"mode","label":"Mode","type":"select","options":["Physical","Virtual","Hybrid"],"required":true}]},{"id":"review","title":"Review and Schedule","fields":[]}]}';
 d2 jsonb;
 t uuid; r jsonb; q jsonb; s jsonb; id text; payload jsonb; edit jsonb; discard jsonb;
BEGIN
 r:=public.convay_meeting_template_manage('create',jsonb_build_object('tenant_id',a,'title','Board review','template_key','board_review','definition',d,'request_id',gen_random_uuid()));
 t:=(r->>'template_id')::uuid;
 r:=public.convay_meeting_template_manage('publish',jsonb_build_object('template_id',t,'expected_revision',1,'request_id',gen_random_uuid()));
 IF r->>'published_revision' IS DISTINCT FROM '1' THEN RAISE EXCEPTION 'publish revision mismatch'; END IF;
 r:=public.convay_meeting_template_manage('read',jsonb_build_object('template_id',t,'revision',1));
 IF r->'template'->'definition' IS DISTINCT FROM d THEN RAISE EXCEPTION 'published template mismatch'; END IF;
 payload:=jsonb_build_object('request_id',gen_random_uuid(),'template_id',t,'template_revision',1,'meeting_title','Budget draft','values',jsonb_build_object('purpose','Budget review'),'wizard_step_id','participants','partial_save',true);
 BEGIN
   PERFORM public.convay_company_meeting_drafts('create',a,(payload-'wizard_step_id'-'partial_save')||jsonb_build_object('request_id',gen_random_uuid()));
   RAISE EXCEPTION 'legacy incomplete draft unexpectedly accepted';
 EXCEPTION WHEN check_violation THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_meeting_drafts('create',a,payload||jsonb_build_object('wizard_step_id','unknown','request_id',gen_random_uuid()));
   RAISE EXCEPTION 'unknown wizard step accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_meeting_drafts('create',a,payload||jsonb_build_object('partial_save','true','request_id',gen_random_uuid()));
   RAISE EXCEPTION 'string partial flag accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 r:=public.convay_company_meeting_drafts('create',a,payload);
 id:=r->>'draft_id';
 IF id IS NULL OR r->>'wizard_step_id' IS DISTINCT FROM 'participants' OR r->'meeting_activation_enabled' IS DISTINCT FROM 'false'::jsonb THEN RAISE EXCEPTION 'create receipt mismatch'; END IF;
 IF public.convay_company_meeting_drafts('create',a,payload) IS DISTINCT FROM r THEN RAISE EXCEPTION 'create replay mismatch'; END IF;
 BEGIN
   PERFORM public.convay_company_meeting_drafts('create',a,payload||jsonb_build_object('wizard_step_id','review'));
   RAISE EXCEPTION 'changed create intent accepted';
 EXCEPTION WHEN unique_violation THEN NULL; END;
 s:=public.convay_company_draft_lifecycle('read',a,jsonb_build_object('draft_id',id));
 IF s->'draft'->>'wizard_step_id' IS DISTINCT FROM 'participants' OR s->'draft'->'values' IS DISTINCT FROM payload->'values' OR s->'draft'->'definition' IS DISTINCT FROM d THEN RAISE EXCEPTION 'partial save readback mismatch'; END IF;
 d2:=jsonb_set(d,'{steps,0,title}','"Revised meeting details"');
 PERFORM public.convay_meeting_template_manage('revise',jsonb_build_object('template_id',t,'expected_revision',1,'definition',d2,'request_id',gen_random_uuid()));
 PERFORM public.convay_meeting_template_manage('publish',jsonb_build_object('template_id',t,'expected_revision',2,'request_id',gen_random_uuid()));
 s:=public.convay_company_draft_lifecycle('read',a,jsonb_build_object('draft_id',id));
 IF s->'draft'->'definition' IS DISTINCT FROM d OR s->'draft'->>'template_revision' IS DISTINCT FROM '1' THEN RAISE EXCEPTION 'pinned template mutated'; END IF;
 edit:=jsonb_build_object('draft_id',id,'expected_revision',1,'request_id',gen_random_uuid(),'meeting_title','Budget draft revised','values',jsonb_build_object('purpose','Budget review','mode','Hybrid'),'wizard_step_id','mode_quorum','partial_save',true);
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('update',a,edit||jsonb_build_object('values',jsonb_build_object('mode','Invalid')));
   RAISE EXCEPTION 'invalid enum accepted';
 EXCEPTION WHEN invalid_parameter_value THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('update',a,edit||jsonb_build_object('values',jsonb_build_object('roster','unverified member')));
   RAISE EXCEPTION 'unsupported linked field accepted';
 EXCEPTION WHEN check_violation THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('update',a,edit||jsonb_build_object('partial_save',false));
   RAISE EXCEPTION 'incomplete final save accepted';
 EXCEPTION WHEN check_violation THEN NULL; END;
 r:=public.convay_company_draft_lifecycle('update',a,edit);
 IF r->>'edit_revision' IS DISTINCT FROM '2' OR r->>'wizard_step_id' IS DISTINCT FROM 'mode_quorum' OR r->>'draft_id' IS DISTINCT FROM id THEN RAISE EXCEPTION 'edit receipt mismatch'; END IF;
 IF public.convay_company_draft_lifecycle('update',a,edit) IS DISTINCT FROM r THEN RAISE EXCEPTION 'edit replay mismatch'; END IF;
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('update',a,edit||jsonb_build_object('request_id',gen_random_uuid()));
   RAISE EXCEPTION 'stale revision accepted';
 EXCEPTION WHEN serialization_failure THEN NULL; END;
 s:=public.convay_company_draft_lifecycle('read',a,jsonb_build_object('draft_id',id));
 IF s->'draft'->'definition' IS DISTINCT FROM d OR s->'draft'->>'wizard_step_id' IS DISTINCT FROM 'mode_quorum' OR s->'draft'->'values' IS DISTINCT FROM edit->'values' THEN RAISE EXCEPTION 'resume exact step failed'; END IF;
 q:=public.convay_company_draft_lifecycle('list',a,'{}');
 IF q->'draft_progress_supported' IS DISTINCT FROM 'true'::jsonb OR jsonb_array_length(q->'drafts')<>1 THEN RAISE EXCEPTION 'duplicate draft or capability missing'; END IF;

 PERFORM set_config('request.jwt.claim.sub','bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',true);
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('read',a,jsonb_build_object('draft_id',id));
   RAISE EXCEPTION 'foreign tenant read accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('read',b,jsonb_build_object('draft_id',id));
   RAISE EXCEPTION 'foreign draft id accepted';
 EXCEPTION WHEN no_data_found THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_meeting_drafts('create',b,payload||jsonb_build_object('request_id',gen_random_uuid()));
   RAISE EXCEPTION 'foreign template accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('update',a,edit);
   RAISE EXCEPTION 'foreign tenant update accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 BEGIN
   PERFORM * FROM convay_private.company_meeting_draft_staging;
   RAISE EXCEPTION 'direct private table read accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM set_config('request.jwt.claim.sub','cccccccc-cccc-4ccc-8ccc-cccccccccccc',true);
 BEGIN
   PERFORM public.convay_company_draft_lifecycle('read',a,jsonb_build_object('draft_id',id));
   RAISE EXCEPTION 'ordinary member admin read accepted';
 EXCEPTION WHEN insufficient_privilege THEN NULL; END;
 PERFORM set_config('request.jwt.claim.sub','aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',true);
 discard:=jsonb_build_object('draft_id',id,'expected_revision',2,'request_id',gen_random_uuid());
 r:=public.convay_company_draft_lifecycle('discard',a,discard);
 IF r->>'status' IS DISTINCT FROM 'Discarded' OR public.convay_company_draft_lifecycle('discard',a,discard) IS DISTINCT FROM r THEN RAISE EXCEPTION 'discard replay mismatch'; END IF;
 IF jsonb_array_length(public.convay_company_draft_lifecycle('list',a,'{}')->'drafts')<>0 THEN RAISE EXCEPTION 'discard not reflected'; END IF;
 RAISE NOTICE 'PASS: published template → partial create/replay → immutable revision → edit/recovery → tenant denials → discard';
END $test$;
RESET ROLE;
DO $test$
BEGIN
 IF (SELECT count(*) FROM convay_private.tenant_control_events WHERE action IN ('company_meeting_draft_created','company_meeting_draft_updated','company_meeting_draft_discarded'))<>3 THEN RAISE EXCEPTION 'audit count mismatch'; END IF;
 IF (SELECT count(*) FROM public.convay_entity_records WHERE entity_key='bms.meetings')<>1 THEN RAISE EXCEPTION 'staging unexpectedly activated a real meeting'; END IF;
END $test$;
ROLLBACK;
