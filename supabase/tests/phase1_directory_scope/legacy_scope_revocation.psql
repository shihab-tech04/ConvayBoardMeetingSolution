-- Disposable synthetic SQL test. Uses the exact existing registry and Storage
-- boundary migrations. Permissive fixture grants isolate the restrictive
-- security condition; they are not production grants.
\set ON_ERROR_STOP on
BEGIN;
-- The earlier fixture creates cluster-wide roles; the second database must
-- reuse those roles without changing their attributes.
DO $fixture$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN CREATE ROLE anon NOLOGIN; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN CREATE ROLE authenticated NOLOGIN; END IF;
END $fixture$;
CREATE SCHEMA auth;
CREATE SCHEMA storage;
CREATE SCHEMA convay_private;
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT NULLIF(current_setting('request.jwt.claim.sub',true),'')::uuid
$$;
GRANT USAGE ON SCHEMA auth,storage,convay_private TO authenticated,anon;
CREATE TABLE public.user_profiles(user_id uuid PRIMARY KEY,account_role text NOT NULL,account_status text NOT NULL);
CREATE TABLE convay_private.tenants(id uuid PRIMARY KEY,lifecycle_state text NOT NULL);
CREATE TABLE convay_private.tenant_memberships(tenant_id uuid,user_id uuid,membership_state text,revoked_at timestamptz,revision bigint NOT NULL DEFAULT 1,PRIMARY KEY(tenant_id,user_id));
CREATE TABLE public.convay_entity_records(entity_key text,record_id text,tenant_id uuid,payload jsonb NOT NULL,PRIMARY KEY(entity_key,record_id));
CREATE TABLE storage.objects(bucket_id text,name text,PRIMARY KEY(bucket_id,name));
ALTER TABLE public.convay_entity_records ENABLE ROW LEVEL SECURITY;
ALTER TABLE storage.objects ENABLE ROW LEVEL SECURITY;
GRANT SELECT,UPDATE,INSERT ON public.convay_entity_records TO authenticated;
GRANT SELECT,INSERT,UPDATE ON storage.objects TO authenticated;
CREATE POLICY fixture_registry_grant ON public.convay_entity_records FOR ALL TO authenticated USING(true) WITH CHECK(true);
CREATE POLICY fixture_storage_grant ON storage.objects FOR ALL TO authenticated USING(true) WITH CHECK(true);
INSERT INTO public.user_profiles VALUES
