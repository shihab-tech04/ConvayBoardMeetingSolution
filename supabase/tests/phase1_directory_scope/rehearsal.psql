\set ON_ERROR_STOP on
-- Run ONLY on a new disposable PostgreSQL 17 instance. Synthetic role claims;
-- never point at hosted production or label as native restore/real Auth UAT.
BEGIN;
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE SCHEMA auth;
CREATE SCHEMA convay_private;
CREATE FUNCTION auth.uid() RETURNS uuid LANGUAGE sql STABLE AS $$
 SELECT nullif(current_setting('request.jwt.claim.sub',true),'')::uuid $$;
GRANT USAGE ON SCHEMA auth,convay_private TO authenticated;
CREATE TABLE public.user_profiles(user_id uuid primary key,display_name text,email text,phone text,employee_id text,user_type text,account_role text,account_status text,profile_data jsonb default '{}'::jsonb,updated_at timestamptz);
CREATE TABLE public.convay_roles(id uuid primary key,name text,status text);
CREATE TABLE public.convay_user_roles(user_id uuid,role_id uuid);
CREATE TABLE public.convay_permissions(id text,status text);
CREATE TABLE public.convay_role_permissions(role_id uuid,permission_id text);
CREATE TABLE convay_private.tenants(id uuid primary key,lifecycle_state text);
CREATE TABLE convay_private.tenant_memberships(tenant_id uuid,user_id uuid,membership_state text,revoked_at timestamptz);
CREATE TABLE public.convay_entity_records(entity_key text,record_id text,tenant_id uuid,payload jsonb);
CREATE TABLE convay_private.org_member_assignment_receipts(actor_id uuid,request_id uuid,member_id uuid,old_unit_id text,new_unit_id text,operation text,reason text,revision bigint,effective_date date,handover_user_id uuid,new_position text,receipt jsonb);
CREATE FUNCTION convay_private.has_permission(permission_code text) RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $$
 SELECT coalesce((select case when p.account_role='super_admin' then true else exists(select 1 from public.convay_user_roles ur join public.convay_roles r on r.id=ur.role_id join public.convay_role_permissions rp on rp.role_id=r.id join public.convay_permissions cp on cp.id=rp.permission_id where ur.user_id=p.user_id and r.status='Active' and cp.id=permission_code and cp.status='Active') end from public.user_profiles p where p.user_id=(select auth.uid()) and p.account_status='active'),false) $$;
CREATE FUNCTION convay_private.legacy_unscoped_authorized() RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path TO '' AS $$
 SELECT coalesce((select p.account_role='super_admin' OR NOT EXISTS(select 1 from convay_private.tenant_memberships m join convay_private.tenants t on t.id=m.tenant_id where m.user_id=p.user_id and m.membership_state='active' and m.revoked_at is null and t.lifecycle_state<>'offboarded') from public.user_profiles p where p.user_id=(select auth.uid()) and p.account_status='active'),false) $$;
